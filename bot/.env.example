# Trading mode gate. MUST default to "paper". Only set to "live" deliberately,
# with real exchange keys below, once you have decided to risk real capital.
TRADING_MODE=paper

# Bitvavo API credentials — required only when TRADING_MODE=live.
# Paper mode needs no credentials: it reads public market data and simulates fills.
BITVAVO_API_KEY=
BITVAVO_API_SECRET=

# Binance is used read-only for research/history; no keys needed for public OHLCV endpoints.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Where Parquet data lives.
DATA_DIR=./data
